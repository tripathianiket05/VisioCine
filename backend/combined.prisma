datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Movie {
  id          String     @id @default(uuid())
  title       String
  genre       String
  posterUrl   String?    @db.Text
  backdropUrl String?    @db.Text
  overview    String?    @db.Text
  trailerUrl  String?    @db.Text
  cast        Json?
  rating      Float?
  duration    Int?
  releaseYear Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Showtimes   Showtime[]
}

model Theatre {
  id        String     @id @default(uuid())
  name      String
  lat       Float
  lon       Float
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Showtimes Showtime[]
}

model Showtime {
  id         String   @id @default(uuid())
  movieId    String
  theatreId  String
  startTime  DateTime
  movie      Movie    @relation(fields: [movieId], references: [id])
  theatre    Theatre  @relation(fields: [theatreId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


model Booking {
  id          String   @id @default(uuid())
  userId      String
  showtimeId  String
  seatIds     Json
  status      String   @default("PENDING") // PENDING, CONFIRMED, FAILED
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OutboxEvent {
  id        String   @id @default(uuid())
  eventType String
  payload   Json
  status    String   @default("PENDING") // PENDING, PROCESSED
  createdAt DateTime @default(now())
}
